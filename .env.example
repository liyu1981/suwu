# Copy to .env and adjust as needed. Values are loaded at startup; variables
# already present in the shell environment take precedence over this file.

# Dev mode: set to true for air hot-reload defaults (port 8000, dev banner).
#SUWU_DEV=false

# Bind address (default 127.0.0.1). Use 0.0.0.0 to expose on all interfaces.
HOST=127.0.0.1

# Server mode: https, http, or https+http (default https).
SERVER_MODE=https

# HTTPS and HTTP listener ports.
HTTPS_PORT=8181
HTTP_PORT=8180

# Extra hostnames/IPs allowed in Host and Origin headers.
# Example: EXTRA_HOSTS=terminal.example.com,*.lan.example
#EXTRA_HOSTS=

# Log level: debug, info, warn, error (default: error).
#SUWU_LOG_LEVEL=error

# Port of the Go demo server for `pnpm dev:web` (Vite) to proxy /api and /ws.
# Leave unset to use the Go dev wrapper default (8000), or set to match HTTP_PORT.
#DEMO_PORT=8000

# TLS — HTTPS is the default mode. Certs are required; the server fails
# if none are found. Easiest: run `suwu gencerts`, which writes a cert pair
# into ~/.config/suwu/ and records the paths in ~/.config/suwu/.env
# (picked up automatically by `suwu serve`). Or set explicitly:
#TLS_CERT_FILE=var/tls-cert.pem
#TLS_KEY_FILE=var/tls-key.pem

# AUTH_PASS is configured by `suwu onboard` and is required for web access.
# It stores the SHA-256 hash of the password, not the plaintext password.
#AUTH_PASS=

# Idle session timeout — how long an unattached session stays alive.
# Default: 24h. Supports Go duration format (e.g. 30m, 12h, 48h).
#SESSION_TTL=24h

# Unix socket path for `suwu ping` notifications (default ~/.suwu/suwu.sock).
#SUWU_SOCK_PATH=~/.suwu/suwu.sock