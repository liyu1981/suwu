{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "includes": ["src/**/*.{ts,tsx,json}"],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": "off",
      "complexity": "off",
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "style": "off",
      "suspicious": "off"
    }
  },
  "assist": {
    "enabled": false
  }
}
